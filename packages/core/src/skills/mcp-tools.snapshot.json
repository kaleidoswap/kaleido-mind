        "amount": {
          "type": "number",
          "description": "Expected amount in display units (e.g. 65.5 for 65.5 USDT)"
        },
        "duration_seconds": {
          "type": "integer",
          "description": "Invoice expiry (default: 86400 = 24h)"
        },
        "transport_endpoints": {
          "type": "array",
