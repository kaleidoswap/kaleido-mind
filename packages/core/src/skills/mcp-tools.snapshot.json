    "kaleidoswap_lsp_create_asset_channel": {
      "required": [
        "asset",
        "asset_amount",
        "rfq_id"
      ],
      "properties": {
        "asset": {
          "type": "string",
          "description": "Asset ticker or id (must match the quote)"
        },
        "asset_amount": {
          "type": "number",
          "description": "Asset amount in display units (must match the quote)"
