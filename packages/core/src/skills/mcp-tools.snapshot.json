        "channel_fee_sat": {
          "type": [
            "number",
            "null"
          ],
          "description": "Internal: channel fee in sats (from the quote). Do not set."
        },
        "expires_at": {
          "type": [
            "number",
            "null"
          ],
          "description": "Internal: quote expiry unix seconds. Do not set."
        }
      }
