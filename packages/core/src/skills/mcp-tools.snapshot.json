        "rfq_id": {
          "type": "string",
          "description": "The rfq_id from kaleidoswap_lsp_quote_asset_channel (must still be valid)"
        },
        "total_sat": {
          "type": [
            "number",
            "null"
          ],
          "description": "Internal: total cost in sats (from the quote). Do not set."
        },
        "btc_amount_sat": {
          "type": [
            "number",
            "null"
          ],
          "description": "Internal: asset price in sats (from the quote). Do not set."
