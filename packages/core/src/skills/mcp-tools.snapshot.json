    "kaleidoswap_get_quote": {
      "required": [
        "from_asset_id",
        "to_asset_id"
      ],
      "properties": {
        "from_asset_id": {
          "type": "string",
          "description": "Asset to sell — ticker ('BTC') or RGB protocol ID ('rgb:...')"
        },
        "to_asset_id": {
          "type": "string",
          "description": "Asset to buy"
        },
        "from_layer": {
          "type": "string",
          "description": "Source layer: 'BTC_LN', 'BTC_SPARK', 'RGB_LN'. Optional — derived from the asset when omitted."
        },
        "to_layer": {
          "type": "string",
          "description": "Destination layer: 'RGB_LN', 'BTC_SPARK', 'BTC_LN'. Optional — derived from the asset when omitted."
        },
        "from_amount": {
          "type": "number",
          "description": "Amount to SELL in display units (e.g. 0.001 BTC). Provide either from_amount or to_amount, not both."
        },
        "to_amount": {
          "type": "number",
          "description": "Amount to BUY/receive in display units (e.g. 1.0 USDT). Provide either from_amount or to_amount, not both."
        }
      }
    },
