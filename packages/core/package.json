{
  "name": "@kaleidorg/mind",
  "version": "0.10.10",
  "description": "Local-first reasoning + function-calling engine for KaleidoSwap. QVAC-powered.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaleidoswap/kaleido-mind.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/tools/mcp.d.ts",
      "import": "./dist/tools/mcp.js",
      "default": "./dist/tools/mcp.js"
    },
    "./skills": {
      "types": "./dist/skills/loader.d.ts",
      "import": "./dist/skills/loader.js",
      "default": "./dist/skills/loader.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "default": "./dist/logger.js"
    },
    "./qvac": {
      "types": "./dist/qvac/index.d.ts",
      "import": "./dist/qvac/index.js",
      "default": "./dist/qvac/index.js"
    },
    "./openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js",
      "default": "./dist/providers/openai.js"
    },
    "./kaleidoswap": {
      "types": "./dist/kaleidoswap/index.d.ts",
      "import": "./dist/kaleidoswap/index.js",
      "default": "./dist/kaleidoswap/index.js"
    },
    "./lsps1": {
      "types": "./dist/lsps1/index.d.ts",
      "import": "./dist/lsps1/index.js",
      "default": "./dist/lsps1/index.js"
    },
    "./submarine": {
      "types": "./dist/submarine/index.d.ts",
      "import": "./dist/submarine/index.js",
      "default": "./dist/submarine/index.js"
    },
    "./bitrefill": {
      "types": "./dist/bitrefill/index.d.ts",
      "import": "./dist/bitrefill/index.js",
      "default": "./dist/bitrefill/index.js"
    },
    "./flashnet": {
      "types": "./dist/flashnet/index.d.ts",
      "import": "./dist/flashnet/index.js",
      "default": "./dist/flashnet/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js",
      "default": "./dist/knowledge/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "skills",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run mcp.live",
    "lint": "eslint src",
    "bundle-skills": "node scripts/bundle-skills.mjs"
  },
  "peerDependencies": {
    "@qvac/sdk": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "@qvac/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@qvac/sdk": "^0.21.0",
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  }
}
