{
  "name": "@kaleidorg/mind-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive terminal harness for @kaleidorg/mind — run the full agent (QVAC + skills + memory + RAG + tools) on your Mac to test before mobile/desktop.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "kaleido-mind": "./dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "eval": "tsx src/index.ts eval",
    "eval:product": "tsx src/index.ts product-eval",
    "eval:product:mock": "tsx src/index.ts product-eval --mock",
    "eval:all": "bash run-eval.sh",
    "serve": "tsx src/index.ts serve"
  },
  "dependencies": {
    "@buildonspark/spark-sdk": "^0.13.0",
    "@flashnet/sdk": "^0.5.10",
    "@kaleidorg/mind": "workspace:*",
    "@scure/bip39": "^2.4.0"
  },
  "peerDependencies": {
    "@qvac/sdk": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
