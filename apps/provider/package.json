{
  "name": "@kaleidorg/mind-provider",
  "version": "0.10.1",
  "description": "Node sidecar that runs a @kaleidorg/mind agent on @qvac/sdk and speaks JSON-RPC over stdio.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "kaleido-mind-provider": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kaleidoswap/kaleido-mind",
    "directory": "apps/provider"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@kaleidorg/mind": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "peerDependencies": {
    "@qvac/sdk": ">=0.20.0"
  },
  "devDependencies": {
    "@qvac/sdk": "^0.21.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
